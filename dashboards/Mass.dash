#
# Main arguments, all optional
#
title: Music Assistant
widget_dimensions: [122, 120]
widget_margins: [5, 5]
columns: 14

ha_frame:
    widget_type: iframe
    title: Music Assistant
    #refresh: 5
    url_list:
      - http://192.168.xx.xx:8095

#
# Includes (Optional)
#
layout:
   - ha_frame(14x8)
   - spacer(12x1)
   - spacer(12x1)   
   - spacer(12x1)
   - spacer(12x1) 
   - spacer(12x1)  
   - spacer(12x1) 
   - spacer(12x1)  
   - include: bottom1_panel
